# Written for you as .env.local when the project is created, and rewritten on
# every build turn so rotated keys land without you doing anything.
#
# The two NEXT_PUBLIC_ values are compiled into browser code and are safe to
# expose. BACKEND_ADMIN_KEY bypasses row-level security and must only ever be
# read from server code.
NEXT_PUBLIC_BACKEND_URL=https://example.backend.result.dev
NEXT_PUBLIC_BACKEND_ANON_KEY=publishable-key
BACKEND_ADMIN_KEY=admin-key
