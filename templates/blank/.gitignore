# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files. .env.local holds this app's backend keys and is regenerated on
# every build turn, so it must never be committed. The example is safe.
.env*
!.env.example
.env.local

# build state written by the builder (setup log, dev server markers)
.result/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
